# Enable or disable the bundled Apache Airflow service by editing this line.
# Available profiles: airflow
# Remove 'airflow' to run JupyterLab without a local Airflow instance (e.g. when
# pointing the extension at a remote Airflow via AIRFLOW_API_URL).
COMPOSE_PROFILES=airflow

# Directory bind-mounted read-only to /root/.ssh inside the jupyter container
# (it runs as root — see docker/README.md). Defaults to an empty, gitignored
# placeholder (no-op). Point it at your real SSH directory to use your own
# keys for git inside the container, e.g.:
#   HOST_SSH_DIR=${HOME}/.ssh          # macOS/Linux/Git Bash
#   HOST_SSH_DIR=C:/Users/you/.ssh     # Windows (PowerShell/cmd)
HOST_SSH_DIR=./docker/ssh-keys
